# --- LLM ---
GROQ_API_KEY=your_groq_api_key_here
RADAR_LLM_BACKEND=groq                 # groq | ollama
RADAR_GROQ_MODEL=openai/gpt-oss-120b         # incident analysis
RADAR_GROQ_TRIAGE_MODEL=openai/gpt-oss-20b   # triage (separate per-model rate limit)
RADAR_REASONING_EFFORT=low                   # gpt-oss reasoning tokens count against the TPM limit
RADAR_OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_BASE_URL=http://localhost:11434
RADAR_TPM_LIMIT=8000                   # Groq tokens-per-minute budget

# --- Discovery ---
# RADAR_COUNTRIES=US,GB,IN,AU,NG,ZA,KE,PH,AE,CA

# --- Geocoding ---
RADAR_USE_NOMINATIM=false
# Nominatim requires an identifying User-Agent with contact details:
# RADAR_GEOCODER_UA=osint-news-radar/2.0 (you@example.com)

# --- Storage ---
RADAR_DB_PATH=data/radar.db
